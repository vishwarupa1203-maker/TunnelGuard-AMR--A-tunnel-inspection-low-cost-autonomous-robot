const float WHEEL_DIAMETER_CM = 6.5f;
const float WHEEL_BASE_CM = 16.0f;
const float TICKS_PER_REV_LEFT = 20.0f;
const float TICKS_PER_REV_RIGHT = 20.0f;

// ------------ MPU6050 ------------
