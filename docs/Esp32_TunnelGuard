const int RIGHT_MOTOR_POLARITY = 1;

int leftMotorCommand = 0;
int rightMotorCommand = 0;

// ------------ Buzzer ------------
const int BUZZER_PIN = 12;  // D12 / GPIO12
const unsigned long BUZZER_DURATION_MS = 2000;

unsigned long buzzerStartMs = 0;
bool buzzerActive = false;

// Assumes an active HIGH buzzer.
void startObstacleBuzzer() {
  digitalWrite(BUZZER_PIN, HIGH);
  buzzerStartMs = millis();
  buzzerActive = true;
}

void updateBuzzer() {
  if (buzzerActive &&
      millis() - buzzerStartMs >= BUZZER_DURATION_MS) {
    digitalWrite(BUZZER_PIN, LOW);
    buzzerActive = false;
  }
}

void stopBuzzer() {
  digitalWrite(BUZZER_PIN, LOW);
  buzzerActive = false;
}

